{
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "local": {
      "vars": {
        "TRUSTED_ORIGINS": "http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3004,http://localhost:3007,https://local.karasu256.com,https://local-accounts.karasu256.com,https://local-qr.karasu256.com,https://local-auth.karasu256.com,https://local-sso.karasu256.com"
      }
    },
    "preview": {
      "name": "sso-karasu256-com",
      "vars": {
        "APP_ENV": "preview",
        "APP_URL": "https://dev.karasu256.com",
        "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
        "AUTH_URL": "https://dev-auth.karasu256.com",
        "TRUSTED_ORIGINS": "https://dev-accounts.karasu256.com,https://*.dev-accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev-sso.karasu256.com,https://dev.karasu256.com,https://dev-qr.karasu256.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
      }
    }
  },
  "main": ".open-next/worker.js",
  "name": "sso-karasu256-com",
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://karasu256.com",
    "AUTH_API_URL": "https://api-auth.karasu256.com",
    "AUTH_URL": "https://auth.karasu256.com",
    "TRUSTED_ORIGINS": "https://accounts.karasu256.com,https://auth.karasu256.com,https://sso.karasu256.com,https://karasu256.com,https://qr.karasu256.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "APP_URL": "https://dev.karasu256.com",
      "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
      "AUTH_URL": "https://dev-auth.karasu256.com",
      "TRUSTED_ORIGINS": "https://dev-accounts.karasu256.com,https://*.dev-accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev-sso.karasu256.com,https://dev.karasu256.com,https://dev-qr.karasu256.com",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
    }
  }
}
